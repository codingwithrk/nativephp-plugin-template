# {{ vendor }}/{{ package }} - {{ plugin }} editor settings
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,neon,yml,yaml,md}]
indent_size = 2

[*.{kt,kts,swift}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
